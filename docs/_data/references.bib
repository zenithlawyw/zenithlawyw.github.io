@INPROCEEDINGS{10.1145/3799830.3799836,
  ABSTRACT  = {The introduction of Quantum Computing marks a new era in the field of computer science. Along with all the potential breakthroughs that Quantum Computing promises, it has also brought the threat of compromising modern cryptographic systems along with it. The classical cryptographic schemes such as RSA and Diffie-Hellman which are based on integer factorization and discrete logarithm problems respectively, are seen to be the most vulnerable since their security has been proven to be compromised with the discovery of Shor’s algorithm. Hence, there is a need for replacing quantum-vulnerable schemes used by applications with quantum-resistant alternatives, popularly known as Post Quantum Cryptography (PQC) schemes.Given the promise of Code Language Models (CLMs) in the program translation task, we have come up with a solution that leverages them to perform automatic translation of quantum-vulnerable code to quantum resistant code. Our solution is the first of its kind to perform dedicated PQC translation on quantum vulnerable code using CLMs. Moreover, we have addressed the limitation of the context length in fine-tuning Sequence-to-Sequence code models. For that we have come up with a novel approach that is able to effectively create structurally and semantically similar chunks between quantum-vulnerable and quantum-resistant programs that exceeds the context limit of a CLM. Our solution is able to achieve a BLEU score of 0.925 when tested on open-sourced real-life github projects.},
  AUTHOR    = {Wahlang, Roisan and Vidhani, Kumar},
  LOCATION  = {New York, NY, USA},
  PUBLISHER = {Association for Computing Machinery},
  URL       = {https://doi.org/10.1145/3799830.3799836},
  BOOKTITLE = {Proceedings of the 13th ACM IKDD International Conference on Data Science},
  DATE      = {2026},
  DOI       = {10.1145/3799830.3799836},
  ISBN      = {979-8-4007-2355-1},
  KEYWORDS  = {Automated Program Translation,Code Language Model,Cyber Security,Post Quantum Cryptography},
  PAGES     = {52--61},
  PAGETOTAL = {10},
  SERIES    = {Cods '25},
  TITLE     = {ccPASTpqc: Post Quantum Cryptography Migration of Programs Using Code Language Models},
}

@ARTICLE{10747171,
  ABSTRACT     = {Currently, data security is one of the most concerning research topics. The traditional RSA encryption system has become vulnerable to quantum algorithms such as Grover and Shor, leading to the development of new security systems for the quantum. As a result, quantum cryptography is gaining importance as a key element of future communication security. This study focuses on quantum key distribution protocols for data quantum encryption, aiming to achieve quantum robustness in all stages of quantum cryptography communication processes. Quantum cryptography communication requires robust quantum encryption not only between end-nodes but also between all components. Therefore, this study demonstrates the process of end-to-end data quantum encryption and proves the overall quantum robustness in this process.},
  AUTHOR       = {Shim, Kyu-Seok and Kim, Boseon and Lee, Wonhyuk},
  DATE         = {2024-09},
  DOI          = {10.13052/jwe1540-9589.2365},
