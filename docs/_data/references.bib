  JOURNALTITLE = {Journal of Web Engineering},
  KEYWORDS     = {data science,Data science,Encryption,key management system,PQC,Protocols,Quantum,Quantum algorithm,Quantum cryptography,Quantum key distribution,Robustness,Security,web security},
  NUMBER       = {6},
  PAGES        = {813--830},
  TITLE        = {Research on Quantum Key, Distribution Key and Post-Quantum Cryptography Key Applied Protocols for Data Science and Web Security},
  VOLUME       = {23},
}

@INPROCEEDINGS{11491399,
  ABSTRACT  = {Conventional cryptographic methods often provide an adequate barrier against traditional attacks; however, they may not be sufficient in the face of the new possibilities of quantum computing. Ensuring secure data transmission against both classical and quantum attacks has become crucial das digital communication grows rapidly We present an integrated system that ensures confidentiality, integrity, and authentication through theby combining-quantum cryptography with DNA-enhanced keys, AES-256-GCM encryption, Dilithium digital signatures, and LSB-based steganography. We show that the experimental findings demonstrate strong performance, with PSNR values ranging from 53.48 dB to 55.27 dB, SSIM values of 0.9929-0.9991, encryption times of less than 1.3\textasciitilde ms, and decryption times of 5-7\textasciitilde ms. The proposed framework presents a viable solution for secure data transmission, and it can provide security against quantum attacks.},
  AUTHOR    = {Fahomida, Maiesha and Nafis, Farhan Ahmad},
  BOOKTITLE = {2025 28th International Conference on Computer and Information Technology (ICCIT)},
  DATE      = {2025-12},
  DOI       = {10.1109/ICCIT68739.2025.11491399},
  ISSN      = {2474-9656},
  KEYWORDS  = {AES-256-GCM,Communication equipment,Communication systems,Data communication,Digital communication,Dilithium,DNA Cryptography,Field programmable gate arrays,HTTP,Image Security,Network resource management,Pixel,Post-Quantum Cryptography,Protocols,Receivers,Steganography},
  PAGES     = {5287--5292},
  TITLE     = {Post Quantum Cryptography Framework for Secure Data Transmission: Enhancing Confidentiality and Integrity with Kyber, Dilithium, and DNA-Keys},
}

@INPROCEEDINGS{11398533,
  ABSTRACT  = {As the power industry's digital transformation accelerates, commercial cryptography as a core technical means to ensure the safe and stable operation of power systems, is facing unprecedented opportunities and challenges. This study focuses on the cryptography application scenarios across the generation, transmission, transformation, distribution, and consumption links of the power industry. It systematically analyzes the technical path for migrating from traditional cryptography applications to post-quantum computing-resistant cryptography applications, explores the implementation scheme of quantum key distribution (QKD) technology in internal communication networks, and discusses the application prospects of privacy-preserving computation technology for data services. The research indicates that the power industry has established a relatively sound commercial cryptography application system. However, against the backdrop of the looming threat of quantum computing, the security of traditional cryptographic algorithms will face severe challenges. By constructing a `traditional cryptography-post-quantum computing-resistant cryptography hybrid architecture', deploying quantum key distribution (QKD) networks, and applying privacy-preserving computation technology for data services, the cryptographic security protection capability of power systems can be significantly enhanced. This study provides theoretical guidance and technical support for the upgrading and transformation of the commercial cryptography protection technology system in the power industry.},
  AUTHOR    = {Huang, Kaitian and Pan, Yuan},
  BOOKTITLE = {2025 5th International Conference on Computer Science, Electronic Information Engineering and Intelligent Control Technology (CEI)},
  DATE      = {2025-11},
  DOI       = {10.1109/CEI66465.2025.11398533},
  KEYWORDS  = {Cryptography,Data Privacy-Preserving Computation Technology,Elliptic curve cryptography,Hybrid power systems,Post-Quantum Computing-Resistant Cryptography Application Migration,Power industry,Power system reliability,Protection,Quantum computing,Quantum key distribution,Quantum Key Distribution Network,Quantum Key Distribution Technology,Standards,Systems architecture,Traditional Cryptography-Post-Quantum Computing-Resistant Cryptography Hybrid Architecture},
  PAGES     = {350--356},
  TITLE     = {Research on the Commercial Cryptography Protection Framework for the Power Sector: A Roadmap from Legacy Cryptography to Post-Quantum Migration},
}

@INPROCEEDINGS{11324504,
  ABSTRACT  = {Rapid advancements in quantum computing pose a significant threat to classical cryptographic systems such as RSA and ECC, creating an urgent need for post-quantum cryptography (PQC) to ensure long-term security. Deoxyribonucleic acid (DNA) has emerged as a promising medium for robust and covert data transmission due to its high information density, durability, and inherent concealment properties. This work introduces a hybrid security framework that combines PQC mechanisms with DNA-based encoding to enhance data confidentiality, integrity, and resilience against noise in biological communication channels. The ChaCha20Poly1305 algorithm provides authenticated encryption, while HKDF enables secure session key derivation across protocol layers. Kyber, a lattice-based key encapsulation mechanism (KEM), serves as the post-quantum key exchange component. Ciphertexts are transformed into DNA sequences through a balanced 2-bit mapping scheme, CRC16 verification, repetition coding, marker-based synchronization, and optional parity grouping. A biologically realistic noise model is constructed using substitutions, insertions, and deletions. Experimental results show that complete data recovery is achievable in substitution-dominant channels when employing a repetition factor of R equals 3, with an associated overhead of approximately 14.6 times. However, environments characterized by high rates of insertions and deletions remain challenging, highlighting the need for improved synchronization strategies and more robust outer-coding techniques. Overall, the proposed framework integrates standardized PQC algorithms with lightweight DNA-centric error-resilience methods, providing a modular foundation for secure, quantum-resistant, and privacy-preserving communication.},
  AUTHOR    = {Joseph, Jaiby Mariya and Sreeja, C.S. and Vinod, Smitha},
  BOOKTITLE = {2025 IEEE International Conference on Communication, Networks and Satellite (COMNETSAT)},
  DATE      = {2025-12},
  DOI       = {10.1109/COMNETSAT68601.2025.11324504},
  ISSN      = {2689-8004},
  KEYWORDS  = {and Data Security,Biological information theory,Decoding,DNA sequencing,DNA-Based Encoding,Encapsulation,Encoding,Encryption,Hybrid Cryptographic Framework,Indel Noise,Noise,Post-Quantum Cryptography,Quantum computing,Redundancy,Synchronization},
  PAGES     = {122--129},
  TITLE     = {Integrating Post-Quantum Cryptography with DNA-Based Data Storage for Secure and Robust Data Preservation},
}

@INPROCEEDINGS{11212458,
  ABSTRACT  = {The Internet of Things (IoT) implementation experience has escalated the security, privacy and scalability concerns and there is more worry that the advent and execution of quantum computers will put the classical cryptography algorithms RSA and ECC at risk. The study deals with the acute problem of providing security solutions to IoT data transmission in a post-quantum world, where lattice-based post-quantum cryptography (Kyber-512 cryptography encryption, Dilithium signatures) is combined with a streamlined blockchain system. The given system would encrypt IoT sensor data through quantum-proof algorithms and record hashbooks on the blockchain and secure data confidentiality, integrity, and authenticity. The low-latency, resource-friendly, energy-efficient verification capability of the proposed consensus protocol is optimized based on Practical Byzantine Fault Tolerance (PBFT) consensus protocol. Evaluation Experimental evidence has shown encryption accuracy of at least 99.97},
  AUTHOR    = {Krishnan, Anguraju and Arunachalam, Rajesh},
  BOOKTITLE = {2025 6th International Conference on Electronics and Sustainable Communication Systems (ICESC)},
  DATE      = {2025-09},
  DOI       = {10.1109/ICESC65114.2025.11212458},
  ISSN      = {2996-5357},
  KEYWORDS  = {Bit error rate,Blockchain,Consensus protocol,Data communication,Data privacy,Dilithium,Encryption,Internet of Things,IoT Security,Kyber-512,Lattice-Based Encryption,Post-Quantum Cryptography,Quantum computing,Real-time systems,Scalability,Throughput},
  PAGES     = {685--690},
  TITLE     = {Implementing Post-Quantum Cryptography in Blockchain for Securing IoT Data Transmission},
}

@INPROCEEDINGS{10454235,
  ABSTRACT  = {Quantum era is near and advanced quantum computing will pose a huge threat to the security of the current cryptographic systems in distributed energy resources (DER)rich power grids. It is necessary to prepare now to combat quantum computing attacks with serious real-world consequences in the years ahead. Recently, post-quantum cryptography (PQC) is considered as one of the major candidates of quantum attack defense strategies, and the adoption of PQC for DER systems has not been fully studied yet. This paper discusses the adoption of PQC in a standard DER network protocol (i.e., IEEE 2030.5-PQC), and proposes a real-time hardware-in-the-loop co-simulation PQC testbed consisting of a DER physical system simulation and a cyber system simulation such as DER gateways and DER management system (DERMS) server. Universal custom-made PQC client and server software are developed to meet the compliant with IEEE 2030.5-2018 standard and implemented in the DER gateways and the DERMS server, respectively. Finally, the feasibility of the proposed PQC-grade DER network is validated by using the real-time co-simulation testbed.},
  AUTHOR    = {Nakka, Kalyan and Ahmad, Seerin and Kim, Taesic and Atkinson, Logan and Ammari, Habib M.},
  BOOKTITLE = {2024 IEEE Power & Energy Society Innovative Smart Grid Technologies Conference (ISGT)},
  DATE      = {2024-02},
  DOI       = {10.1109/ISGT59692.2024.10454235},
  ISSN      = {2472-8152},
  KEYWORDS  = {Cybersecurity,distributed energy resources,Distributed power generation,hardware-in-the-loop testbed,Logic gates,post quantum cryptography,Quantum computing,Real-time systems,Servers,Standards,Systems simulation},
  PAGES     = {1--5},
  TITLE     = {Post-Quantum Cryptography (PQC)-Grade IEEE 2030.5 for Quantum Secure Distributed Energy Resources Networks},
}

@INPROCEEDINGS{10866709,
  ABSTRACT  = {Quantum computing poses a significant threat to traditional cryptographic systems, necessitating the exploration of robust alternatives to secure data transmission in the cloud. This abstract delves into the integration of Post-Quantum Cryptography (PQC) and Cloud Security Posture Management (CSPM) as a comprehensive solution. The proposed framework advocates for the adoption of a variant of the McEliece cryptosystem within the cloud infrastructure, providing resistance against potential quantum attacks. Encryption, fortified by Post-Quantum Cryptography, emerges as the dominant method for ensuring the security of cloud-stored data. In parallel, Cloud Security Posture Management (CSPM) is introduced as a set of security protocols designed to identify and remediate cloud misconfigurations, enhancing the overall security posture. This research highlights the synergy between PQC and CSPM, showcasing their collective effectiveness in mitigating emerging threats in cloud computing. The integration of Quantum Key Distribution (QKD) further enhances data security, ensuring the confidentiality and integrity of transmitted information. The proposed model not only addresses current data breach challenges but also anticipates the evolving landscape of quantum computing, providing a forward-looking solution for secure data transmission in cloud environments.},
  AUTHOR    = {Rajkumar, N and Kumar, K Kishore and Gokul, M. and Durai, S.},
  BOOKTITLE = {2024 4th International Conference on Ubiquitous Computing and Intelligent Information Systems (ICUIS)},
  DATE      = {2024-12},
  DOI       = {10.1109/ICUIS64676.2024.10866709},
  KEYWORDS  = {Cloud computing security,Cloud Security,Cloud Security Posture Management,Data Security,Data transfer,Encryption,Post-Quantum Cryptography,Protocols,Quantum computing,Quantum key distribution,Quantum Key Distribution,Resistance,Security,Throughput,Ubiquitous computing},
  PAGES     = {1456--1462},
  TITLE     = {Post-Quantum Cryptography Security with CSPM for Secure Data Transmission in Cloud Environments},
}

@INPROCEEDINGS{11414715,
  ABSTRACT  = {The dynamic growth of Internet of Things (IoT) has allowed data monitoring and automation in a wide variety of areas, consequently, caused severe consequences in data security and integrity vulnerability. This study suggests the usage of a Post-Quantum Cryptography (PQC) blockchain framework that will protect IoT communications against classical and quantum computing attacks. The framework incorporates Kyber Key Encapsulation Mechanism (KEM) to provide lightweight, quantum-resistant confidentiality and Dilithium digital signatures to provide strong authentication along with the SHA3-256 hashing algorithm to assure data integrity. A permissioned blockchain with Proofof-Authority (PoA) consensus makes it efficient to validate transactions and in an immutable format. Python 3.13 using PQClean libraries was experimentally evaluated and consisted of simulating IoT devices broadcasting environmental telemetry to the nodes of the blockchain. The dataset consisted of the payloads of different size of 64 bytes up to 1024 bytes, and both normal and adversarial network environments. Tests show encryption/decryption times of less than 1.5 ms, a signature verification time of less than 1.5 ms, transaction commit time of fewer than 75 ms and integrity verification accuracy better than 90 percent even with attacks. The suggested solution comprises a scalable security layer of the IoT systems, which ensures the confidentiality, authenticity, and integrity of the sent data and is low latency and quantum secure, preserving the efficiency of the work of the operational solution.},
  AUTHOR    = {Raju, K Krishnam and Rao, R Hemasundara and Behara, B Neelima and Kumar, G S Santhosh and Harshitha, M and Varshney, Abhishek},
  BOOKTITLE = {2025 3rd International Conference on IoT, Communication and Automation Technology (ICICAT)},
  DATE      = {2025-12},
  DOI       = {10.1109/ICICAT68430.2025.11414715},
  KEYWORDS  = {Authentication,Blockchain-Based IoT Security,Blockchains,Cryptography,Data integrity,Digital Signature Authentication,Digital signatures,Encryption,Handwriting recognition,Internet of Things,Lightweight Encryption,Payloads,Quantum-Resistant Cryptography,Real-time systems,Secure Data Transmission},
  PAGES     = {1--6},
  TITLE     = {Blockchain-Based Secure IoT Data Transmission Leveraging Post-Quantum Cryptography},
}

