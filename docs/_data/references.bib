  KEYWORDS  = {Protocols;Scalability;Conferences;Memory management;Lightning;Bitcoin;Logic gates;Internet of things;cryptocurrency;bitcoin;lightning network},
  PAGES     = {1--3},
  TITLE     = {Enabling Micro-payments on IoT Devices using Bitcoin Lightning Network},
}

